# ==============================================================================
# REQUIRED IN PRODUCTION (Google Cloud Run)
# ==============================================================================

# Application execution environment ("production" or "development")
NODE_ENV="development"

# Port on which the Express HTTP server listens (Cloud Run injects PORT=8080 automatically)
PORT="3000"

# Public canonical base URL used for links, payment return URLs, and webhooks
APP_URL="http://localhost:3000"

# Secret key for JWT signing (minimum 32 characters in production; store in Secret Manager)
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

# Encryption key for payment gateway credentials (minimum 16 characters, distinct from JWT_SECRET)
GATEWAY_ENCRYPTION_KEY="replace-with-gateway-encryption-key-min-16-chars"

# Primary seeded super admin email address (defaults to admin@joymediapr.com if unset)
ADMIN_INITIAL_EMAIL="admin@joymediapr.com"

# Initial password for seeded super admin accounts (no default; leave empty to use /admin first-run setup)
ADMIN_INITIAL_PASSWORD=""

# Optional second owner super admin email address (second super admin is only seeded when set)
ADMIN_OWNER_EMAIL=""

# Optional display name for the second owner super admin account (defaults to "Agency Owner")
ADMIN_OWNER_NAME=""

# One-time setup token required by POST /api/auth/admin-setup when NODE_ENV=production
ADMIN_SETUP_TOKEN=""

# ==============================================================================
# DATABASE (PostgreSQL / Google Cloud SQL - NO Firebase)
# ==============================================================================
# Option A: Connection URI (works with TCP PostgreSQL or Cloud SQL Unix socket ?host=/cloudsql/PROJECT:REGION:INSTANCE)
DATABASE_URL="postgresql://user:password@localhost:5432/joymediapr_dev"

# Option B: Discrete fields (recommended for Cloud Run + Cloud SQL Unix Socket)
# Set SQL_HOST="/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE"
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
# Optional separate migration admin role (defaults to SQL_USER if omitted)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
# Optional app role to GRANT schema permissions to during migration (only applied if role exists)
POSTGRES_APP_USER=""

# Optional standard libpq aliases & TLS flags (SSL is automatically disabled for /cloudsql/ Unix sockets)
PGHOST=""
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""
PGSSL="false"
PGSSLMODE="prefer"
PGSSLREJECTUNAUTHORIZED="true"
PG_POOL_MAX="20"

# ==============================================================================
# STORAGE & EMAIL (Required in Production)
# ==============================================================================

# Google Cloud Storage bucket name for persistent deliverable uploads (required in production on Cloud Run)
GCS_BUCKET_NAME=""

# Google Cloud Project ID (optional; Cloud Run auto-detects via ADC)
GOOGLE_CLOUD_PROJECT=""

# API key for transactional emails via Resend (required in production)
RESEND_API_KEY=""

# Verified sender address for system and notification emails (required in production)
EMAIL_FROM="notifications@joymediapr.com"

# ==============================================================================
# PAYMENT GATEWAYS (PayPal, Stripe, Razorpay)
# ==============================================================================

# PayPal REST API ("sandbox" or "live")
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Stripe (optional; can also be configured in Admin -> Payment Gateways)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (optional; can also be configured in Admin -> Payment Gateways)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# AUTHENTICATION & RUNTIME BEHAVIOR
# ==============================================================================

# Google OAuth 2.0 Credentials for "Continue with Google" Login & Registration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Trust X-Forwarded-For headers from Cloud Run / reverse proxies ("true" or "false")
TRUST_PROXY="true"

# Require email verification prompt on new-device login ("true" or "false")
USER_DEVICE_VERIFICATION="false"

# Review window in days before delivered orders auto-accept (defaults to 7 in agency mode)
REVIEW_WINDOW_DAYS="7"

# Master toggle for background automated review window release ("true" or "false")
AUTO_ACCEPT_ENABLED="true"

# ==============================================================================
# TESTING & NON-PRODUCTION ONLY (Never enable in production)
# ==============================================================================

# Allow simulated credit card / mock checkout deposits without real payment gateways (TEST ONLY)
PAYMENT_SIMULATION_ENABLED="false"

# Expose mock 2FA verification codes in API responses for automated testing (TEST ONLY)
ALLOW_MOCK_CODES="false"

# Allow administrative database purge endpoint POST /api/admin/reset-data (TEST ONLY)
ALLOW_DATA_RESET="false"

# Custom directory for local embedded PGlite storage files (DEV ONLY)
PGLITE_DATA_DIR="./data/pgdata"

# File path for diagnostic debug logging (TEST/DEBUG ONLY)
DIAGNOSTIC_LOG_FILE=""

# Unix timestamp cutoff for legacy session token migration (0 = disabled)
LEGACY_TOKEN_COMPAT_UNTIL_MS="0"
